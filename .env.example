# ===== 공통 =====
# 실제 값은 .env 파일에 작성 (커밋 금지). 팀 노션/MM으로 공유.

# ===== Backend =====
DB_URL=jdbc:postgresql://localhost:5432/woojuin
DB_USERNAME=woojuin
DB_PASSWORD=woojuin-local
REDIS_HOST=localhost
REDIS_PORT=6379
CHAT_BOT_SECRET=
DISCORD_PUBLIC_KEY=
# 명령 등록 스크립트에서만 사용. 백엔드 실행에는 필요하지 않다.
DISCORD_APPLICATION_ID=
VITE_DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# 비우면 전역 명령, 입력하면 해당 테스트 서버에 즉시 반영되는 guild 명령으로 등록한다.
DISCORD_GUILD_ID=
MATTERMOST_SLASH_TOKEN=
# Mattermost 검색 결과의 "우주인에서 보기" 딥링크 origin. 운영에서는 실제 웹앱 주소.
CHAT_INTEGRATION_FRONTEND_URL=http://localhost:5173
# Mattermost Site URL. 로컬 PC의 주소가 아니라 Mattermost 사용자가 접속하는 서버 origin.
MATTERMOST_SERVER_URL=
MATTERMOST_OAUTH_CLIENT_ID=
MATTERMOST_OAUTH_CLIENT_SECRET=
# 로컬 터널 예: https://<tunnel>/api/integrations/mattermost/oauth/callback
MATTERMOST_OAUTH_REDIRECT_URI=
MATTERMOST_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/my
# OAuth 토큰 DB 암호화 키(운영에서 32바이트 이상 랜덤값, 변경 시 기존 토큰 재연결 필요).
MATTERMOST_TOKEN_ENCRYPTION_KEY=
# Mattermost 플러그인과 우주인 API가 공유하는 별도 랜덤 토큰.
MATTERMOST_PLUGIN_TOKEN=
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# CORS 허용 출처. 목록에 없는 Origin 은 브라우저가 막기 전에 Spring 이 403 으로 먼저 자른다.
# **웹앱 주소를 반드시 포함해야 한다** — 코드가 localhost 를 따로 더해 주지 않는다(운영에서도
# 개발 주소가 허용되는 걸 막기 위해 그 하드코딩을 걷었다).
# 익스텐션 ID 는 고정이다: manifest 에 웹스토어 공개키(key)를 넣어 두어 압축해제 설치도 같은
# ID 를 쓴다 — 팀원마다 다른 ID 를 추가할 필요가 없다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://aifkmpjpjedlamliamnloliencimdfco
# 개발 서버:
# CORS_ALLOWED_ORIGINS=https://dev.woojuin.store,chrome-extension://aifkmpjpjedlamliamnloliencimdfco
# 운영:
# CORS_ALLOWED_ORIGINS=https://woojuin.store,chrome-extension://aifkmpjpjedlamliamnloliencimdfco
# AI 키. 값은 SSAFY GMS 키를 넣는다 — GMS가 OpenAI 호환 프록시라 변수 이름만 OpenAI 것을 쓴다.
# 비어 있으면 AI 검색이 규칙 기반으로 폴백한다(앱 기동엔 지장 없지만 오타 교정이 빠진다).
OPENAI_API_KEY=
# 이미지 분석(OCR·설명·태그) 키. OpenRouter 경유 Qwen3-VL — 위 텍스트 AI와 프로바이더가
# 달라 키도 별도다. 비어 있으면 이미지 텍스트 추출만 꺼지고(아이템은 PARTIAL로 저장)
# 썸네일·EXIF 좌표·저장은 정상 동작한다(앱 기동엔 지장 없음).
OPENROUTER_API_KEY=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# 지도 좌표 변환(주소↔좌표)용 카카오 로컬 API 키. 위 OAuth 키와 **다른 값**이다 —
# 같은 카카오 앱의 "REST API 키"를 넣는다. 지도 SDK가 아니라 서버측 REST 호출이다.
# 비어 있으면 지오코딩만 꺼지고, 지도 공유 링크·사진 EXIF에서 읽은 좌표는 계속 저장된다
# (앱 기동엔 지장 없음).
KAKAO_REST_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AWS_REGION=ap-northeast-2
OAUTH_REDIRECT_BASE_URL=http://localhost:5173/oauth/callback
# 로컬 개발은 docker-compose의 MinIO를 씀. 운영 배포 시엔 AWS_S3_ENDPOINT를
# 빈 값으로 비우면 S3Config가 실제 AWS S3(DefaultCredentialsProvider) 경로로 전환된다.
AWS_S3_BUCKET=woojuin-items
AWS_S3_ENDPOINT=http://localhost:9000
# presigned URL 서명용 공개 주소. **로컬은 비워 둔다**(위 endpoint 로 폴백 — localhost 는
# 브라우저도 닿음). 배포 환경에서만 https://minio.<env>.woojuin.store 가 주입된다.
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_ACCESS_KEY=woojuin
AWS_S3_SECRET_KEY=woojuin-local
FCM_PROJECT_ID=
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 받은 JSON을
# base64 한 줄로 인코딩해서 넣는다(원본 JSON은 개행이 있어 .env에 그대로 못 넣음).
# 비어 있으면 NoOpPushSender로 폴백 — 로그만 남기고 실제 발송은 생략된다.
# macOS/Linux: base64 -i service-account.json | tr -d '\n'
# Windows(PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FCM_SERVICE_ACCOUNT_KEY_BASE64=
# Scrapling 크롤러 폴백(JS 렌더링·봇 차단 페이지를 스텔스 브라우저로 재시도).
# crawler는 docker-compose에 포함돼 `docker compose up -d`로 같이 뜨므로 기본 켜둠.
# 크롤러를 안 띄운 채 백엔드만 돌릴 땐 false로 꺼도 됨(그땐 Jsoup 결과만 사용).
CRAWLER_ENABLED=true
CRAWLER_BASE_URL=http://localhost:8001
# AI Mix 사이드카(요약·카테고리 분류·임베딩·3D 좌표. ai/ai-mix, OpenRouter 필요).
# docker-compose에 포함돼 같이 뜨므로 기본 켜둠. 사이드카 없이 백엔드만 돌릴 땐
# false로 끄면 요약·분류만 조용히 꺼진다(저장·미리보기·OCR은 정상).
AIMIX_ENABLED=true
AIMIX_BASE_URL=http://localhost:8002
# 노래 인식(FR-055) — 워치 "노래 찾기"가 쓰는 AudD 정식 API 토큰.
# 비어 있으면 이 기능만 꺼진다(앱 기동엔 지장 없다). https://dashboard.audd.io/
# 무료 300건 뒤 초과분이 자동 과금되고 하드 리밋이 문서에 없다 — 그래서 서버는 곡을
# 못 찾은 경우에 재시도하지 않는다(인식 1회 = 요청 1건).
# 한도는 계정 단위이므로 로컬·dev·prod 가 같은 토큰을 써도 된다.
AUDD_API_TOKEN=
# 월 500개 아이템까지 비검색 AI 처리. false면 제한 기능 전체를 즉시 해제한다.
AI_USAGE_LIMIT_ENABLED=true
AI_USAGE_MONTHLY_ITEM_LIMIT=500
AI_USAGE_RESERVATION_TTL_MINUTES=60
QUEUE_MAX_LENGTH=10000

# ===== Frontend (Vite는 VITE_ 접두사 필수) =====
VITE_API_BASE_URL=http://localhost:8080/api
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 확인.
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_STORAGE_BUCKET=
VITE_FCM_MESSAGING_SENDER_ID=
VITE_FCM_APP_ID=
# 웹 푸시 구독용 VAPID 공개키. Firebase 콘솔 > 프로젝트 설정 > 클라우드 메시징 >
# 웹 구성 > 웹 푸시 인증서에서 확인.
VITE_FCM_VAPID_KEY=
