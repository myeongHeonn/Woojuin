# ===== 공통 =====
# 실제 값은 .env 파일에 작성 (커밋 금지). 팀 노션/MM으로 공유.

# ===== Backend =====
DB_URL=jdbc:postgresql://localhost:5432/woojuin
DB_USERNAME=woojuin
DB_PASSWORD=woojuin-local
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# AI 키. 값은 SSAFY GMS 키를 넣는다 — GMS가 OpenAI 호환 프록시라 변수 이름만 OpenAI 것을 쓴다.
# 비어 있으면 AI 검색이 규칙 기반으로 폴백한다(앱 기동엔 지장 없지만 오타 교정이 빠진다).
OPENAI_API_KEY=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
# 지도 좌표 변환(주소↔좌표)용 카카오 로컬 API 키. 위 OAuth 키와 **다른 값**이다 —
# 같은 카카오 앱의 "REST API 키"를 넣는다. 지도 SDK가 아니라 서버측 REST 호출이다.
# 비어 있으면 지오코딩만 꺼지고, 지도 공유 링크·사진 EXIF에서 읽은 좌표는 계속 저장된다
# (앱 기동엔 지장 없음).
KAKAO_REST_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AWS_REGION=ap-northeast-2
OAUTH_REDIRECT_BASE_URL=http://localhost:5173/oauth/callback
# 로컬 개발은 docker-compose의 MinIO를 씀. 운영 배포 시엔 AWS_S3_ENDPOINT를
# 빈 값으로 비우면 S3Config가 실제 AWS S3(DefaultCredentialsProvider) 경로로 전환된다.
AWS_S3_BUCKET=woojuin-items
AWS_S3_ENDPOINT=http://localhost:9000
# presigned URL 서명용 공개 주소. **로컬은 비워 둔다**(위 endpoint 로 폴백 — localhost 는
# 브라우저도 닿음). 배포 환경에서만 https://minio.<env>.woojuin.store 가 주입된다.
AWS_S3_PUBLIC_ENDPOINT=
AWS_S3_ACCESS_KEY=woojuin
AWS_S3_SECRET_KEY=woojuin-local
FCM_PROJECT_ID=
# Scrapling 크롤러 폴백(JS 렌더링·봇 차단 페이지를 스텔스 브라우저로 재시도).
# crawler는 docker-compose에 포함돼 `docker compose up -d`로 같이 뜨므로 기본 켜둠.
# 크롤러를 안 띄운 채 백엔드만 돌릴 땐 false로 꺼도 됨(그땐 Jsoup 결과만 사용).
CRAWLER_ENABLED=true
CRAWLER_BASE_URL=http://localhost:8001

# ===== Frontend (Vite는 VITE_ 접두사 필수) =====
VITE_API_BASE_URL=http://localhost:8080/api
VITE_FCM_VAPID_KEY=
